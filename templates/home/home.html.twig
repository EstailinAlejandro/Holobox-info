{% extends 'base.html.twig' %}

{% block body %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-4">
            <h2>holobox applicatie </h2>
        </div>
        <div class="container">
            <div class="row">


                <div class="col-4">
                <div class="card" style="width: 18rem;">
