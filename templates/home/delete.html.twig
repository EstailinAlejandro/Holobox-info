{% extends 'base.html.twig' %}

{% block title %}Delete{% endblock %}



{% block body %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}" role="alert">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}


    <table class="table">
    <thead>
    <tr>
        <th scope="col">name</th>
        <th scope="col">filename</th>
    </tr>
    </thead>

    <tbody>
    {% for file in files %}
        <tr>
            <td>{{ file.name  }}</td>
            <td>{{ file.filename }}</td>
            <td><a href="{{ path('OnlyVideo', {'id': file.id}) }} ">
                    <button class="btn btn-warning">Zie video</button></a></td>
            <td><a href="{{ path('delete', {'id': file.id}) }} "  onclick="return confirm('Weet je zeker dat je dit product wilt verwijderen?')">
                    <button class="btn btn-danger">Verwijderen</button></a></td>


        </tr>
    {% endfor %}






{% endblock %}